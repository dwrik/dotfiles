# exclude everything
*

# allow .gitignore file
!.gitignore

# allow specific files
!.zshrc
!.zprofile
!.vimrc

# allow specific directories and their contents
!.config/
!.config/**

# ignore defaults & redundants
.config/neofetch
.config/nnn
.config/coc
.config/.DS_Store
.config/qBittorrent
.config/alacritty/themes

