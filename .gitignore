# exclude everything
*

# allow .gitignore file
!.gitignore

# allow specific files
!.zshrc
!.zprofile
!.zshenv
!.p10k.zsh
!.ideavimrc
!packages.txt
!README.md

# allow specific directories and their contents
!.config/
!.config/**
!.local/
!.local/bin/
!.local/bin/**

# ignore defaults & redundants
.config/neofetch
.config/nnn
.config/coc
.config/.DS_Store
.config/qBittorrent
.config/vim/plugged
.config/vim/autoload
.config/nvim/autoload
.config/alacritty/themes
.config/yazi/plugins

